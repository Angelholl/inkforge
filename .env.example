# ===== Strata 本地端点（必填，缺失启动即报）=====
STRATA_BASE_URL=http://127.0.0.1:47831/v1
STRATA_API_KEY=strata
STRATA_MODEL=iq3_xxs

# ===== 服务 =====
# HTTP 端口
INKFORGE_PORT=8787
# 运行时数据目录（相对项目根）
INKFORGE_DATA_DIR=data
# 1=全角色走确定性 mock provider（GUI 开发/演示，不调真模型）
INKFORGE_MOCK=0

# ===== 云端 provider（可缺省；三项同时提供才启用）=====
INKFORGE_CLOUD_BASE_URL=
INKFORGE_CLOUD_API_KEY=
INKFORGE_CLOUD_MODEL=

# ===== 角色路由（T31 起生效；local|cloud）=====
INKFORGE_ROLE_PLANNER=local
INKFORGE_ROLE_DRAFTER=local
INKFORGE_ROLE_QC=local
INKFORGE_ROLE_REWRITER=local
INKFORGE_ROLE_SUMMARIZER=local

# ===== 测试覆盖项（一般留空）=====
# 心跳间隔毫秒（测试用 200）
INKFORGE_TEST_HEARTBEAT_MS=
# supervisor 退避毫秒（测试用 100）
INKFORGE_SUPERVISOR_BACKOFF_MS=
