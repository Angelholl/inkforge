; Uninstaller Pages
; 1. Confirm uninstall page
Var DeleteAppDataCheckbox
Var DeleteAppDataCheckboxState
!define /ifndef WS_EX_LAYOUTRTL         0x00400000
!define MUI_PAGE_CUSTOMFUNCTION_SHOW un.ConfirmShow
Function un.ConfirmShow ; Add add a `Delete app data` check box
  ; $1 inner dialog HWND
  ; $2 window DPI
  ; $3 style
  ; $4 x
  ; $5 y
  ; $6 width
  ; $7 height
  FindWindow $1 "#32770" "" $HWNDPARENT ; Find inner dialog
  System::Call "user32::GetDpiForWindow(p r1) i .r2"
  ${If} $(^RTL) = 1
    StrCpy $3 "${__NSD_CheckBox_EXSTYLE} | ${WS_EX_LAYOUTRTL}"
    IntOp $4 50 * $2
  ${Else}
    StrCpy $3 "${__NSD_CheckBox_EXSTYLE}"
    IntOp $4 0 * $2
  ${EndIf}
  IntOp $5 100 * $2
  IntOp $6 400 * $2
  IntOp $7 25 * $2
  IntOp $4 $4 / 96
  IntOp $5 $5 / 96
  IntOp $6 $6 / 96
  IntOp $7 $7 / 96
  System::Call 'user32::CreateWindowEx(i r3, w "${__NSD_CheckBox_CLASS}", w "$(deleteAppData)", i ${__NSD_CheckBox_STYLE}, i r4, i r5, i r6, i r7, p r1, i0, i0, i0) i .s'
  Pop $DeleteAppDataCheckbox
  SendMessage $HWNDPARENT ${WM_GETFONT} 0 0 $1
  SendMessage $DeleteAppDataCheckbox ${WM_SETFONT} $1 1
FunctionEnd
!define MUI_PAGE_CUSTOMFUNCTION_LEAVE un.ConfirmLeave
Function un.ConfirmLeave
  SendMessage $DeleteAppDataCheckbox ${BM_GETCHECK} 0 0 $DeleteAppDataCheckboxState
FunctionEnd
!define MUI_PAGE_CUSTOMFUNCTION_PRE un.SkipIfPassive
!insertmacro MUI_UNPAGE_CONFIRM

; 2. Uninstalling Page
!insertmacro MUI_UNPAGE_INSTFILES

;Languages
; PageReinstall reads the misspelled `choowHowToInstall` as a fallback, and makensis warns
; about a language string that is read but never set, so default it to an empty string for
; every language. This runs before the language files are included, so a custom language
; file that only defines the old spelling overrides the default and the fallback shows its
; text. `0` as the language id means the language inserted right above.
; TODO: remove the `choowHowToInstall` fallback in a future major version
!insertmacro MUI_LANGUAGE "English"
LangString choowHowToInstall 0 ""
!insertmacro MUI_RESERVEFILE_LANGDLL
  !include "English.nsh"

; ============================================================================
; Inkforge C: drive install guard (DEC-2026-1112-03)
; Adds: fixed non-system drive selection, writability/space probe, path
; normalization (case/junction/subst/UNC/device) and a TEMP audit log.
; Upstream installer logic is intentionally left untouched.
; ============================================================================

Function InkforgeLog
  Push $0
  FileOpen $0 "$TEMP\inkforge-install.log" a
  ${If} $0 != ""
    FileWrite $0 "$InkforgeLogText$\r$\n"
    FileClose $0
  ${EndIf}
  Pop $0
FunctionEnd

; Input:  $InkforgePathIn
; Output: $InkforgeResolvedPath / $InkforgeResolvedRoot / $InkforgeResolvedIsSystem
Function InkforgeResolveRoot
  Push $0
  Push $1
  Push $2
  Push $3
  Push $4

  ${If} $InkforgeSystemDrive == ""
    ${GetRoot} "$WINDIR" $InkforgeSystemDrive
  ${EndIf}

  StrCpy $InkforgeResolvedPath ""
  StrCpy $InkforgeResolvedRoot ""
  StrCpy $InkforgeResolvedIsSystem 0
  StrCpy $InkforgePathOut "$InkforgePathIn"

  ; Normalize relative segments and separators first.
  System::Call 'kernel32::GetFullPathNameW(w "$InkforgePathOut", i ${NSIS_MAX_STRLEN}, w .r0, p 0) i .r1'
  ${If} $0 != ""
    StrCpy $InkforgePathOut "$0"
  ${EndIf}

  inkforge_resolve_try:
    System::Call 'kernel32::CreateFileW(w "$InkforgePathOut", i 0, i 3, p 0, i 3, i 0x02000000, p 0) i .r2'
    ${If} $2 != -1
      System::Call 'kernel32::GetFinalPathNameByHandleW(p r2, w .r0, i ${NSIS_MAX_STRLEN}, i 0) i .r1'
      System::Call 'kernel32::CloseHandle(p r2)'
      ${If} $0 != ""
        StrCpy $InkforgePathOut "$0"
      ${EndIf}
      Goto inkforge_resolve_done
    ${EndIf}
    ; Path does not exist yet: resolve the nearest existing ancestor instead.
    ${GetParent} "$InkforgePathOut" $0
    ${If} $0 == ""
      Goto inkforge_resolve_done
    ${EndIf}
    ${If} $0 == $InkforgePathOut
      Goto inkforge_resolve_done
    ${EndIf}
    StrCpy $InkforgePathOut "$0"
    Goto inkforge_resolve_try

  inkforge_resolve_done:
  ; Strip the \\?\ prefix and rebuild \\?\UNC\server\share paths.
  StrCpy $0 "$InkforgePathOut" 4
  ${If} $0 == "\\?\"
    StrCpy $InkforgePathOut "$InkforgePathOut" "" 4
    StrCpy $0 "$InkforgePathOut" 4
    ${If} $0 == "UNC\"
      StrCpy $InkforgePathOut "$InkforgePathOut" "" 4
      StrCpy $InkforgePathOut "\\$InkforgePathOut"
    ${EndIf}
  ${EndIf}

  StrCpy $InkforgeResolvedPath "$InkforgePathOut"
  ${GetRoot} "$InkforgePathOut" $0
  ${If} $0 == ""
    ${GetRoot} "$InkforgePathIn" $0
  ${EndIf}
  StrCpy $InkforgeResolvedRoot "$0"

  ${If} $InkforgeResolvedRoot == $InkforgeSystemDrive
    StrCpy $InkforgeResolvedIsSystem 1
  ${Else}
    ; Catch local admin-share / device aliases that point at the system drive.
    ${StrCase} $1 "$InkforgePathOut" "L"
    StrCpy $3 "$InkforgeSystemDrive" 1
    ${StrCase} $3 "$3" "L"
    StrCpy $3 "$3$$"
    ${StrLoc} $2 "$1" "\\localhost\$3\" ">"
    ${If} $2 == ""
      ${StrLoc} $2 "$1" "\\127.0.0.1\$3\" ">"
    ${EndIf}
    ${If} $2 == ""
      ReadEnvStr $4 "COMPUTERNAME"
      ${If} $4 != ""
        ${StrCase} $4 "$4" "L"
        ${StrLoc} $2 "$1" "\\$4\$3\" ">"
      ${EndIf}
    ${EndIf}
    ${If} $2 == ""
      ${StrLoc} $2 "$1" "\\.\$3" ">"
    ${EndIf}
    ${If} $2 != ""
      StrCpy $InkforgeResolvedIsSystem 1
    ${EndIf}
  ${EndIf}

  Pop $4
  Pop $3
  Pop $2
  Pop $1
  Pop $0
FunctionEnd

; Pick "<drive>:\${PRODUCTNAME}" on a writable fixed non-system drive.
; Priority: drive containing the installer, then alphabetical order.
Function InkforgePickInstallDir
  Push $0
  Push $1
  Push $2
  Push $3
  Push $4
  Push $5
  Push $6
  Push $7

  ${If} $InkforgeSystemDrive == ""
    ${GetRoot} "$WINDIR" $InkforgeSystemDrive
  ${EndIf}

  StrCpy $InkforgeNoDrive 0
  StrCpy $InkforgeChosenDir ""
  StrCpy $InkforgeFirstValid ""

  ${GetRoot} "$EXEDIR" $InkforgePreferredRoot
  StrCpy $InkforgeLogText "[inkforge] installer=$EXEDIR preferred=$InkforgePreferredRoot system=$InkforgeSystemDrive"
  Call InkforgeLog

  System::Call 'kernel32::GetLogicalDrives() i .r0'
  StrCpy $InkforgeDriveMask $0
  StrCpy $InkforgeDriveIndex 0

  inkforge_drive_loop:
    IntCmp $InkforgeDriveIndex 26 inkforge_drive_done
    IntOp $1 1 << $InkforgeDriveIndex
    IntOp $1 $1 & $InkforgeDriveMask
    IntCmp $1 0 inkforge_drive_next

    IntOp $2 $InkforgeDriveIndex + 65
    IntFmt $3 "%c" $2
    StrCpy $InkforgeDriveRoot "$3:\"
    StrCpy $InkforgeCandidate "$3:\${PRODUCTNAME}"

    System::Call 'kernel32::GetDriveTypeW(w "$InkforgeDriveRoot") i .r4'
    StrCpy $InkforgeDriveType $4
    ${If} $InkforgeDriveType != 3
      StrCpy $InkforgeLogText "[inkforge] skip $InkforgeDriveRoot reason=not-fixed type=$InkforgeDriveType"
      Call InkforgeLog
      Goto inkforge_drive_next
    ${EndIf}

    StrCpy $5 "$3:"
    ${If} $5 == $InkforgeSystemDrive
      StrCpy $InkforgeLogText "[inkforge] skip $InkforgeDriveRoot reason=system-drive"
      Call InkforgeLog
      Goto inkforge_drive_next
    ${EndIf}

    ; Probe inside the target subdirectory, never at the drive root.
    StrCpy $InkforgeProbeCreated 0
    ${IfNot} ${FileExists} "$InkforgeCandidate\*.*"
      CreateDirectory "$InkforgeCandidate"
      StrCpy $InkforgeProbeCreated 1
    ${EndIf}
    FileOpen $6 "$InkforgeCandidate\.inkforge-write-probe" w
    ${If} $6 == ""
      ${If} $InkforgeProbeCreated == 1
        RMDir "$InkforgeCandidate"
      ${EndIf}
      StrCpy $InkforgeLogText "[inkforge] skip $InkforgeDriveRoot reason=not-writable"
      Call InkforgeLog
      Goto inkforge_drive_next
    ${EndIf}
    FileWrite $6 "inkforge"
    FileClose $6
    Delete "$InkforgeCandidate\.inkforge-write-probe"
    ${If} $InkforgeProbeCreated == 1
      RMDir "$InkforgeCandidate"
    ${EndIf}

    System::Call 'kernel32::GetDiskFreeSpaceExW(w "$InkforgeDriveRoot", *l .r6, *l .r7, *l .r0) i .r4'
    StrCpy $InkforgeFreeBytes $6
    ${If} $4 == 0
      StrCpy $InkforgeLogText "[inkforge] skip $InkforgeDriveRoot reason=space-query-failed"
      Call InkforgeLog
      Goto inkforge_drive_next
    ${EndIf}
    System::Int64Op $InkforgeFreeBytes < 1073741824
    Pop $7
    ${If} $7 == 1
      StrCpy $InkforgeLogText "[inkforge] skip $InkforgeDriveRoot reason=low-space free=$InkforgeFreeBytes"
      Call InkforgeLog
      Goto inkforge_drive_next
    ${EndIf}

    StrCpy $InkforgePathIn "$InkforgeCandidate"
    Call InkforgeResolveRoot
    ${If} $InkforgeResolvedIsSystem == 1
      StrCpy $InkforgeLogText "[inkforge] skip $InkforgeDriveRoot reason=resolves-to-system final=$InkforgeResolvedPath"
      Call InkforgeLog
      Goto inkforge_drive_next
    ${EndIf}

    StrCpy $InkforgeLogText "[inkforge] candidate $InkforgeCandidate free=$InkforgeFreeBytes final=$InkforgeResolvedPath"
    Call InkforgeLog

    ${If} $InkforgeChosenDir == ""
      ${If} $InkforgePreferredRoot != ""
      ${AndIf} $5 == $InkforgePreferredRoot
        StrCpy $InkforgeChosenDir "$InkforgeCandidate"
      ${ElseIf} $InkforgeFirstValid == ""
        StrCpy $InkforgeFirstValid "$InkforgeCandidate"
      ${EndIf}
    ${EndIf}

  inkforge_drive_next:
    IntOp $InkforgeDriveIndex $InkforgeDriveIndex + 1
    Goto inkforge_drive_loop

  inkforge_drive_done:
  ${If} $InkforgeChosenDir == ""
    StrCpy $InkforgeChosenDir "$InkforgeFirstValid"
  ${EndIf}
  ${If} $InkforgeChosenDir == ""
    StrCpy $InkforgeNoDrive 1
    StrCpy $InkforgeLogText "[inkforge] no compliant fixed non-system drive found"
    Call InkforgeLog
  ${Else}
    StrCpy $InkforgeLogText "[inkforge] selected $InkforgeChosenDir"
    Call InkforgeLog
  ${EndIf}

  Pop $7
  Pop $6
  Pop $5
  Pop $4
  Pop $3
  Pop $2
  Pop $1
  Pop $0
FunctionEnd

Function InkforgeLeaveDirPage
  ${If} $InkforgeSystemDrive == ""
    ${GetRoot} "$WINDIR" $InkforgeSystemDrive
  ${EndIf}
  StrCpy $InkforgePathIn "$INSTDIR"
  Call InkforgeResolveRoot
  ${If} $InkforgeResolvedIsSystem == 1
    MessageBox MB_ICONEXCLAMATION "禁止安装到 C 盘，请选择其他磁盘。"
    Abort
  ${EndIf}
FunctionEnd

Function InkforgeCheckInstallDir
  ${If} $InkforgeSystemDrive == ""
    ${GetRoot} "$WINDIR" $InkforgeSystemDrive
  ${EndIf}
  StrCpy $InkforgePathIn "$INSTDIR"
  Call InkforgeResolveRoot
  StrCpy $InkforgeLogText "[inkforge] install target=$INSTDIR resolved=$InkforgeResolvedPath system=$InkforgeResolvedIsSystem"
  Call InkforgeLog
  ${If} $InkforgeResolvedIsSystem == 1
    StrCpy $InkforgeBadDir 1
  ${Else}
    StrCpy $InkforgeBadDir 0
  ${EndIf}
FunctionEnd

Function .onInit
  ${GetOptions} $CMDLINE "/P" $PassiveMode
  ${IfNot} ${Errors}
    StrCpy $PassiveMode 1
  ${EndIf}

  ${GetOptions} $CMDLINE "/NS" $NoShortcutMode
  ${IfNot} ${Errors}
    StrCpy $NoShortcutMode 1
  ${EndIf}

  ${GetOptions} $CMDLINE "/UPDATE" $UpdateMode
  ${IfNot} ${Errors}
    StrCpy $UpdateMode 1
  ${EndIf}

  !if "${DISPLAYLANGUAGESELECTOR}" == "true"
    !insertmacro MUI_LANGDLL_DISPLAY
  !endif

  !insertmacro SetContext

  ${If} $INSTDIR == "${PLACEHOLDER_INSTALL_DIR}"
    ; Set default install location
    !if "${INSTALLMODE}" == "perMachine"
      ${If} ${RunningX64}
        !if "${ARCH}" == "x64"
          StrCpy $INSTDIR "$PROGRAMFILES64\${PRODUCTNAME}"
        !else if "${ARCH}" == "arm64"
          StrCpy $INSTDIR "$PROGRAMFILES64\${PRODUCTNAME}"
        !else
          StrCpy $INSTDIR "$PROGRAMFILES\${PRODUCTNAME}"
        !endif
      ${Else}
        StrCpy $INSTDIR "$PROGRAMFILES\${PRODUCTNAME}"
      ${EndIf}
    !else if "${INSTALLMODE}" == "currentUser"
      ; Inkforge* (DEC-2026-1123-01): silent/passive/update 优先复用上次的安装目录（注册表 InstallLocation，须存在且解析为非 C:），
      ; 防守卫在静默模式把升级选到另一块盘（实测 /P 曾被选往 I:\inkforge 仓根）。复用不成再走 A' 案选盘。
      StrCpy $InkforgePrevReused 0
      ReadRegStr $InkforgePrevDir HKCU "${UNINSTKEY}" "InstallLocation"
      ${If} $InkforgePrevDir != ""
        StrCpy $InkforgePrevChar $InkforgePrevDir 1
        ${If} $InkforgePrevChar == '"'
          StrLen $InkforgePrevLen $InkforgePrevDir
          IntOp $InkforgePrevLen $InkforgePrevLen - 2
          StrCpy $InkforgePrevDir $InkforgePrevDir "" 1
          StrCpy $InkforgePrevDir $InkforgePrevDir $InkforgePrevLen
        ${EndIf}
        ${If} ${FileExists} "$InkforgePrevDir\*.*"
          StrCpy $InkforgePathIn "$InkforgePrevDir"
          Call InkforgeResolveRoot
          ${If} $InkforgeResolvedIsSystem == 0
            StrCpy $INSTDIR "$InkforgePrevDir"
            StrCpy $InkforgePrevReused 1
            StrCpy $InkforgeLogText "[inkforge] reuse-previous=$INSTDIR"
            Call InkforgeLog
          ${EndIf}
        ${EndIf}
      ${EndIf}
      ${If} $InkforgePrevReused == 0
        ; Inkforge: default to a writable fixed non-system drive (A' decision)
        Call InkforgePickInstallDir
        ${If} $InkforgeNoDrive == 1
          ${If} ${Silent}
            SetErrorLevel 3
            Quit
          ${Else}
            MessageBox MB_ICONSTOP "未找到可安装的非 C 盘固定磁盘（需可写且剩余空间不少于 1GB），安装已中止。"
            Quit
          ${EndIf}
        ${EndIf}
        StrCpy $INSTDIR "$InkforgeChosenDir"
      ${EndIf}
    !endif

    Call RestorePreviousInstallLocation

    !if "${INSTALLMODE}" == "currentUser"
      ; Inkforge: never inherit a C: path from the registry
      StrCpy $InkforgePathIn "$INSTDIR"
      Call InkforgeResolveRoot
      ${If} $InkforgeResolvedIsSystem == 1
        ; Inkforge*: 复用分支跳过选盘时 ChosenDir 为空——补选一次，防 INSTDIR 被置空
        ${If} "$InkforgeChosenDir" == ""
          Call InkforgePickInstallDir
        ${EndIf}
        StrCpy $INSTDIR "$InkforgeChosenDir"
      ${EndIf}
    !endif
  ${EndIf}


  !if "${INSTALLMODE}" == "both"
    !insertmacro MULTIUSER_INIT
  !endif

  ; Abort downgrades if they are disabled, in the modes that skip the reinstall page choice:
  ; silent, passive and update
  !if "${ALLOWDOWNGRADES}" == "false"
  ${If} ${Silent}
  ${OrIf} $PassiveMode = 1
  ${OrIf} $UpdateMode = 1
    ; Compare with the same installation the reinstall page would: a WiX one first
    Call FindWixInstall
    ${If} $R6 != ""
      ReadRegStr $R0 HKLM "$R6" "DisplayVersion"
    ${Else}
      ReadRegStr $R0 SHCTX "${UNINSTKEY}" "DisplayVersion"
    ${EndIf}
    nsis_tauri_utils::SemverCompare "${VERSION}" $R0
    Pop $R0
    ; If downgrading
    ${If} $R0 = -1
      ${If} ${Silent}
        System::Call 'kernel32::AttachConsole(i -1)i.r0'
        ${If} $0 <> 0
          System::Call 'kernel32::GetStdHandle(i -11)i.r0'
          System::call 'kernel32::SetConsoleTextAttribute(i r0, i 0x0004)' ; set red color
          FileWrite $0 "$(silentDowngrades)"
        ${EndIf}
      ${Else}
        MessageBox MB_ICONSTOP "$(silentDowngrades)"
      ${EndIf}
      Abort
    ${EndIf}
  ${EndIf}
  !endif
FunctionEnd

Section WebView2
  ; Check if Webview2 is already installed and skip this section
  ${If} ${RunningX64}
    ReadRegStr $4 HKLM "SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\${WEBVIEW2APPGUID}" "pv"
  ${Else}
    ReadRegStr $4 HKLM "SOFTWARE\Microsoft\EdgeUpdate\Clients\${WEBVIEW2APPGUID}" "pv"
  ${EndIf}
  ${If} $4 == ""
    ReadRegStr $4 HKCU "SOFTWARE\Microsoft\EdgeUpdate\Clients\${WEBVIEW2APPGUID}" "pv"
  ${EndIf}

  ${If} $4 == ""
    ; Webview2 installation
    ;
    ; Skip if updating
    ${If} $UpdateMode <> 1
      !if "${INSTALLWEBVIEW2MODE}" == "downloadBootstrapper"
        Delete "$TEMP\MicrosoftEdgeWebview2Setup.exe"
        DetailPrint "$(webview2Downloading)"
        NSISdl::download "https://go.microsoft.com/fwlink/p/?LinkId=2124703" "$TEMP\MicrosoftEdgeWebview2Setup.exe"
        Pop $0
        ${If} $0 == "success"
          DetailPrint "$(webview2DownloadSuccess)"
        ${Else}
          DetailPrint "$(webview2DownloadError)"
          Abort "$(webview2AbortError)"
        ${EndIf}
        StrCpy $6 "$TEMP\MicrosoftEdgeWebview2Setup.exe"
        Goto install_webview2
      !endif

      !if "${INSTALLWEBVIEW2MODE}" == "embedBootstrapper"
        Delete "$TEMP\MicrosoftEdgeWebview2Setup.exe"
        File "/oname=$TEMP\MicrosoftEdgeWebview2Setup.exe" "${WEBVIEW2BOOTSTRAPPERPATH}"
        DetailPrint "$(installingWebview2)"
        StrCpy $6 "$TEMP\MicrosoftEdgeWebview2Setup.exe"
        Goto install_webview2
      !endif

      !if "${INSTALLWEBVIEW2MODE}" == "offlineInstaller"
        Delete "$TEMP\MicrosoftEdgeWebView2RuntimeInstaller.exe"
        File "/oname=$TEMP\MicrosoftEdgeWebView2RuntimeInstaller.exe" "${WEBVIEW2INSTALLERPATH}"
        DetailPrint "$(installingWebview2)"
        StrCpy $6 "$TEMP\MicrosoftEdgeWebView2RuntimeInstaller.exe"
        Goto install_webview2
      !endif

      Goto webview2_done

      install_webview2:
        DetailPrint "$(installingWebview2)"
        ; $6 holds the path to the webview2 installer
        ExecWait "$6 ${WEBVIEW2INSTALLERARGS} /install" $1
        ${If} $1 = 0
          DetailPrint "$(webview2InstallSuccess)"
        ${Else}
          DetailPrint "$(webview2InstallError)"
          Abort "$(webview2AbortError)"
        ${EndIf}
      webview2_done:
    ${EndIf}
  ${Else}
    !if "${MINIMUMWEBVIEW2VERSION}" != ""
      ${VersionCompare} "${MINIMUMWEBVIEW2VERSION}" "$4" $R0
      ${If} $R0 = 1
        update_webview:
          DetailPrint "$(installingWebview2)"
          ${If} ${RunningX64}
            ReadRegStr $R1 HKLM "SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate" "path"
          ${Else}
            ReadRegStr $R1 HKLM "SOFTWARE\Microsoft\EdgeUpdate" "path"
          ${EndIf}
          ${If} $R1 == ""
            ReadRegStr $R1 HKCU "SOFTWARE\Microsoft\EdgeUpdate" "path"
          ${EndIf}
          ${If} $R1 != ""
            ; Chromium updater docs: https://source.chromium.org/chromium/chromium/src/+/main:docs/updater/user_manual.md
            ; Modified from "HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\Microsoft EdgeWebView\ModifyPath"
            ExecWait `"$R1" /install appguid=${WEBVIEW2APPGUID}&needsadmin=true` $1
            ${If} $1 = 0
              DetailPrint "$(webview2InstallSuccess)"
            ${Else}
              MessageBox MB_ICONEXCLAMATION|MB_ABORTRETRYIGNORE "$(webview2InstallError)" IDIGNORE ignore IDRETRY update_webview
              Quit
              ignore:
            ${EndIf}
          ${EndIf}
      ${EndIf}
    !endif
  ${EndIf}
SectionEnd

Section Install
  ; Inkforge: final gate before any file extraction. Also covers silent /D=C:\.
  Call InkforgeCheckInstallDir
  ${If} $InkforgeBadDir == 1
    ${If} ${Silent}
      SetErrorLevel 2
      Quit
    ${Else}
      MessageBox MB_ICONEXCLAMATION "禁止安装到 C 盘，请选择其他磁盘。"
      Abort
    ${EndIf}
  ${EndIf}

  SetOutPath $INSTDIR

