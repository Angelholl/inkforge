{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "墨炉",
  "version": "0.1.2",
  "identifier": "dev.inkforge.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "pnpm --filter @inkforge/web dev",
    "beforeBuildCommand": "pnpm --filter @inkforge/web build"
  },
  "app": {
    "windows": [
      {
        "title": "墨炉 Inkforge",
        "width": 1280,
        "height": 820
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "template": "nsis/inkforge-installer.nsi",
        "installMode": "currentUser"
      }
    },
    "resources": {
      "resources/server/server.mjs": "resources/server/server.mjs",
      "resources/server/worker": "resources/server/worker",
      "resources/server/node_modules": "resources/server/node_modules",
      "resources/server/config": "resources/server/config",
      "resources/server/db": "resources/server/db",
      "resources/web/dist": "resources/web/dist",
      "resources/runtime/node.exe": "resources/runtime/node.exe"
    }
  }
}
